# Copy this file to project.env, then review it before execution.
PROJECT_CODE=saureus_phylogenomics
BIOPROJECT=PRJNA983748
ORGANISM_PLOIDY=1

WORKDIR=${WORKDIR:-"$PROJECT_ROOT/work"}
RAW_DIR=${RAW_DIR:-"$WORKDIR/raw_reads"}
OUTPUT_DIR=${OUTPUT_DIR:-"$PROJECT_ROOT/pipeline_phylogenomics_output"}
REFERENCE_ROOT=${REFERENCE_ROOT:-"$PROJECT_ROOT/references"}

THREADS=${THREADS:-8}
SEED=${SEED:-42}

MIN_QUAL=${MIN_QUAL:-30}
MIN_DEPTH=${MIN_DEPTH:-10}
MAX_DEPTH=${MAX_DEPTH:-150}

# UFBoot support threshold below which a branch is treated as poorly
# supported -- 95 is the value IQ-TREE's own manual recommends for
# ultrafast bootstrap, not an arbitrary round number.
UFBOOT_SUPPORT_THRESHOLD=${UFBOOT_SUPPORT_THRESHOLD:-95}
UFBOOT_REPLICATES=${UFBOOT_REPLICATES:-1000}
